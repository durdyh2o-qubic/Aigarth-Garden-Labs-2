   "source": [
    "# Aigarth Garden Research Observatory\n",
    "**Real Miner Telemetry × Hyperidentity Simulation**\n",
    "\n",
    "## Experimental Objectives\n",
    "- Track mining performance\n",
    "- Correlate simulation fitness with real-world iterations\n",
    "- Provide transparent, real-time insights into hyperidentity evolution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "from pathlib import Path\n",
    "\n",
    "# Configuration and Data Loading\n",
    "mining_path = Path('../mining-logs/parsed_results.csv')\n",
    "sim_paths = sorted(Path('../results').glob('results_mut*.csv'), reverse=True)\n",
    "\n",
    "# Data Loading and Initial Analysis\n",
    "def load_mining_data(path):\n",
    "    if path.exists():\n",
    "        df = pd.read_csv(path)\n",
    "        print(f'Mining Data Summary:')\n",
    "        print(f'  Entries: {len(df)}')\n",
    "        print(f'  Peak Iterations/Second: {df[\"it_s\"].max()}')\n",
    "        print(f'  Average Iterations/Second: {df[\"it_s\"].mean():.2f}')\n",
    "        print(f'  Efficiency Range: {df[\"efficiency\"].min():.4f} - {df[\"efficiency\"].max():.4f}')\n",
    "        return df\n",
    "    return None\n",
    "\n",
    "def load_simulation_data(paths):\n",
    "    if paths:\n",
    "        df = pd.read_csv(paths[0])\n",
    "        print(f'\\nSimulation Data Summary:')\n",
    "        print(f'  Generations: {len(df)}')\n",
    "        print(f'  Peak Fitness: {df[\"best_fitness\"].max():.6f}')\n",
    "        print(f'  Average Fitness: {df[\"best_fitness\"].mean():.6f}')\n",
    "        print(f'  Fitness Improvement: {df[\"best_fitness\"].pct_change().mean()*100:.2f}%')\n",
    "        return df\n",
    "    return None\n",
    "\n",
    "# Load Data\n",
    "mining_df = load_mining_data(mining_path)\n",
    "sim_df = load_simulation_data(sim_paths)\n",
    "\n",
    "# Visualization\n",
    "plt.figure(figsize=(16, 10))\n",
    "\n",
    "# Subplot 1: Mining Performance\n",
    "plt.subplot(2, 1, 1)\n",
    "if mining_df is not None:\n",
    "    plt.plot(mining_df.index, mining_df['it_s'], label='Iterations/Second', color='blue', marker='o')\n",
    "    plt.title('Mining Performance Telemetry')\n",
    "    plt.xlabel('Log Entry')\n",
    "    plt.ylabel('Iterations/Second')\n",
    "    plt.legend()\n",
    "    plt.grid(True)\n",
    "\n",
    "# Subplot 2: Simulation Fitness\n",
    "plt.subplot(2, 1, 2)\n",
    "if sim_df is not None:\n",
    "    plt.plot(sim_df.index, sim_df['best_fitness'], label='Best Network Fitness', color='green', marker='x')\n",
    "    plt.title('Hyperidentity Simulation Fitness')\n",
    "    plt.xlabel('Generation')\n",
    "    plt.ylabel('Fitness Score')\n",
    "    plt.legend()\n",
    "    plt.grid(True)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Optional: Correlation Analysis\n",
    "if mining_df is not None and sim_df is not None:\n",
    "    print('\\nCross-Domain Correlation Analysis:')\n",
    "    # Normalize data for comparison\n",
    "    mining_normalized = (mining_df['it_s'] - mining_df['it_s'].min()) / (mining_df['it_s'].max() - mining_df['it_s'].min())\n",
    "    sim_normalized = (sim_df['best_fitness'] - sim_df['best_fitness'].min()) / (sim_df['best_fitness'].max() - sim_df['best_fitness'].min())\n",
    "    \n",
    "    correlation = np.corrcoef(mining_normalized[:len(sim_normalized)], sim_normalized)[0, 1]\n",
    "    print(f'  Normalized Correlation Coefficient: {correlation:.4f}')"
   ]
  }
